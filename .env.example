# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB (Chat history, raw telemetry logs, Better Auth)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/greenpulse
# Optional: Set custom DNS servers in local development if experiencing Windows SRV ECONNREFUSED
# MONGO_DNS_SERVERS=8.8.8.8,1.1.1.1

# Neon PostgreSQL (Singapore region, Postgres 18)
# DATABASE_URL: Neon pooled connection string (PgBouncer, port 5432) for application runtime queries
DATABASE_URL=postgresql://<user>:<password>@ep-pooler-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# DIRECT_URL: Neon direct unpooled connection string for Prisma CLI migrations and introspection
DIRECT_URL=postgresql://<user>:<password>@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=your-jwt-secret-key-here

# AI Engine API Keys
GEMINI_API_KEY=your-gemini-developer-key
MISTRAL_API_KEY=your-mistral-developer-key
